# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# Postgres (Keycloak's internal database)
DB_PASSWORD=change_this_to_something_strong

# Keycloak admin bootstrap account (used only for first login to the admin console)
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_too

# Public hostname Keycloak will be served on (must match your DNS + Nginx config)
KC_HOSTNAME=sso.asianland.ph
